local function tween(inst, info, props)
    local t = TweenService:Create(inst, info, props)
    t:Play()
    return t
end

local fade = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local rise = TweenInfo.new(0.7, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)

